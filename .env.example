# =============================================================================
# COPTELLER — Standalone & Bank-Agnostic Cooperative Platform (.env.example)
# =============================================================================
# Copteller deploys independently and plugs into ANY Partner Bank settlement rail:
#   - banksuite (Native BankSuite MFB + Headless Submodule Console)
#   - kuda      (Kuda Microfinance Bank Open API v2.1)
#   - qore      (Qore / BankOne Core Banking)
#   - generic_mfb (Custom Partner Bank REST/Webhook rail)

NEXT_PUBLIC_COPTELLER_APP_NAME=Copteller
NEXT_PUBLIC_COPTELLER_APP_URL=http://localhost:3001/copteller
NEXT_PUBLIC_COPTELLER_VERSION=1.0.0

PAYLOAD_SECRET=your-payload-secret
DATABASE_URI=postgresql://postgres.[project]:[password]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
COPTELLER_DATABASE_URI=postgresql://postgres.[project]:[password]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
COPTELLER_DB_SCHEMA=copteller

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

COPTELLER_SUPABASE_URL=https://your-project.supabase.co
COPTELLER_SUPABASE_ANON_KEY=your-anon-key
COPTELLER_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_COPTELLER_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_COPTELLER_SUPABASE_ANON_KEY=your-anon-key

ADMIN_SECRET=your-admin-secret
WORKFLOW_ENCRYPTION_KEY=your-64-char-hex-encryption-key

# =============================================================================
# Bank-Agnostic Settlement Rail & Headless Submodule Bridge (v3.0)
# =============================================================================
# Active settlement partner: banksuite | kuda | qore | generic_mfb
COPTELLER_PARTNER_BANK_PROVIDER=banksuite
COPTELLER_PARTNER_BANK_NAME=Abia SME Microfinance Bank (BankSuite)
COPTELLER_PARTNER_BANK_CODE=090423

# Shared secret for Partner Bank -> Copteller signed Headless Bridge API (/api/copteller/banksuite/bridge)
COPTELLER_BRIDGE_SECRET=shared-bridge-hmac-secret
BANKSUITE_API_URL=https://your-banksuite-instance.vercel.app

# Kuda Microfinance Bank Open API v2.1 (when COPTELLER_PARTNER_BANK_PROVIDER=kuda)
KUDA_EMAIL=your-kuda-business-email
KUDA_API_KEY=your-kuda-openapi-key
KUDA_BASE_URL=https://kuda-openapi.kuda.com/v2.1

# Optional Qore / BankOne Core (when COPTELLER_PARTNER_BANK_PROVIDER=qore)
# QORE_BASE_URL=https://staging.mybankone.com
# QORE_AUTH_TOKEN=your-qore-auth-token
# QORE_INSTITUTION_CODE=090001
